<?xml version="1.0" encoding="utf-8"?>

<!-- Используем LinearLayout для вертикального расположения элементов -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:gravity="center">

    <!-- TextView - поле для вывода сообщения (приветствие или ошибка) -->
    <!-- Изначально пустое, текст заполнится в Java-коде -->
    <TextView
        android:id="@+id/messageTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="18sp"
        android:layout_marginBottom="24dp" />

    <!-- Button - кнопка для возврата на первый экран -->
    <Button
        android:id="@+id/backButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/back_button" />

</LinearLayout>